#!/bin/bash
# inquery entry point

# Get the base directory robustly
APP_ROOT=$(dirname "$(dirname "$(readlink -f "$0")")")

QUERY=""

# 第一階層: Entryモード (1行入力)
while true; do
    QUERY=$(zenity --entry --title="inquery ('..' for multi-line)" --text="" --entry-text="$QUERY" --width=800)
    
    # 入力でキャンセルされたらアプリ終了
    if [ $? -ne 0 ]; then
        exit 0
    fi

    # ".." なら第二階層 (Multi-lineモード) へ
    if [ "$QUERY" = ".." ]; then
        QUERY="" # 複数行モードの初期値は空
        while true; do
            # text-infoはパイプで初期値を渡す (-n で改行付加を防止)
            QUERY=$(echo -n "$QUERY" | zenity --text-info --editable --title="inquery (ctrl+enter to submit)" --width=800 --height=600)
            
            # 複数行入力自体がキャンセルされたら第一階層へ戻る
            if [ $? -ne 0 ]; then
                QUERY=""
                break
            fi

            # 第二階層でのアクション選択
            bash "$APP_ROOT/lib/ui.sh" "$QUERY" "$APP_ROOT"
            
            # 成功ならアプリ終了、キャンセル(非0)なら第二階層(複数行入力)をループ継続
            if [ $? -eq 0 ]; then
                exit 0
            fi
        done
        # 第二階層を抜けたので第一階層の先頭へ
        continue
    fi

    # 第一階層でのアクション選択
    bash "$APP_ROOT/lib/ui.sh" "$QUERY" "$APP_ROOT"
    
    # 成功ならアプリ終了、キャンセル(非0)なら第一階層(1行入力)をループ継続
    if [ $? -eq 0 ]; then
        exit 0
    fi
done