{
  "actions": [
    {
      "label": "Googleで検索",
      "url": "https://www.google.com/search?q={query}"
    },
    {
      "label": "スクリプト例",
      "script": "~/.config/inquery/scripts/example.sh",
      "args": ["{query}"]
    },
    {
      "label": "Geminiで検索",
      "url": "https://gemini.google.com/app",
      "show_if_contains": ["。", "、", ",", "？"],
      "copy_to_clipboard": true
    },
    {
      "label": "Claudeで検索",
      "url": "https://claude.ai/new",
      "show_if_contains": ["。", "、", ",", "？"],
      "copy_to_clipboard": true
    },
    {
      "label": "Grokで検索",
      "url": "https://x.com/i/grok",
      "show_if_contains": ["。", "、", ",", "？"],
      "copy_to_clipboard": true
    }
  ]
}
